---
const { title, imgsrc, titlecolor } = Astro.props;
import "../assets/app.css";
---

<section class="relative h-[400px] overflow-hidden mb-6">
	<img src={imgsrc} class="absolute inset-0 h-full w-full object-cover" />

	<div class="absolute inset-0 bg-gradient-to-t from-black/75 to-transparent">
	</div>
	<div class="relative flex h-full items-end justify-center pb-10">
		<h1 class={titlecolor}>{title}</h1>
	</div>
</section>
